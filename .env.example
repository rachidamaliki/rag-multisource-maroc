# Copier ce fichier en .env et remplir. .env n'est JAMAIS commite.

# --- Generation (choisir UN fournisseur gratuit) ---
# Groq : https://console.groq.com  (gratuit, tres rapide)
GROQ_API_KEY=
# Gemini : https://aistudio.google.com/apikey  (gratuit)
GOOGLE_API_KEY=

# Fournisseur actif : "groq" | "gemini" | "ollama"
LLM_PROVIDER=groq
# Modeles Groq verifies le 2026-08-29 : openai/gpt-oss-120b (qualite),
# qwen/qwen3.8-27b (rapide). Le catalogue Groq change : verifier avec
#   python scripts/check_env.py --models
LLM_MODEL=openai/gpt-oss-120b

# --- Postgres + pgvector (Arc 3, via Docker) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=ragzero
PG_USER=rag
PG_PASSWORD=ragpass
